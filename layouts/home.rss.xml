{{- /* The feed: updates and projects, newest first, with their full text. */ -}}
{{- $pages := partial "stream.html" . }}
{{- $limit := site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}{{ $pages = $pages | first $limit }}{{ end }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <language>{{ site.Language.Locale }}</language>
    {{- with $pages }}
    <lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "rss" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <category>{{ partial "kind.html" . }}</category>
      <description>{{ partial "description.html" . }}</description>
      <content:encoded>{{ printf "<![CDATA[%s]]>" (.Content | transform.XMLEscape | htmlUnescape) | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
