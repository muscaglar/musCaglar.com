# Headers that Cloudflare adds to every page and file of the site.
# They apply to muscaglar.com only; nothing here reaches other addresses on the domain.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'inline-speculation-rules'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Stylesheets, scripts, fonts and processed pictures carry a fingerprint in their names:
# when one changes, its name changes. Browsers may therefore keep them for a year.
/css/*
  Cache-Control: public, max-age=31556952, immutable
/js/*
  Cache-Control: public, max-age=31556952, immutable
/*.avif
  Cache-Control: public, max-age=31556952, immutable
/*.webp
  Cache-Control: public, max-age=31556952, immutable
/*.woff2
  Cache-Control: public, max-age=31556952, immutable

# The site is also reachable at Cloudflare's own addresses (previews, and workers.dev).
# Search engines should list muscaglar.com only.
https://:name.:account.workers.dev/*
  X-Robots-Tag: noindex
